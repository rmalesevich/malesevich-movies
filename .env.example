# Copy to .env and fill in. Never commit the real file.

# --- Core ------------------------------------------------------------------
# Used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# The single site password. Leave blank to disable the login wall entirely
# (only sensible if the app never leaves your LAN).
APP_PASSWORD=

DEBUG=false

# --- TheMovieDB ------------------------------------------------------------
# Either a v3 API key or a v4 read access token works.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Trakt -----------------------------------------------------------------
# Create an API app at https://trakt.tv/oauth/applications and paste the
# Client ID here. Only the client id is needed: the app reads *public*
# profiles, so each participant's Trakt profile must be set to public.
TRAKT_CLIENT_ID=

# --- Daily sync ------------------------------------------------------------
SYNC_ENABLED=true
SYNC_HOUR=4
SYNC_MINUTE=30
TIMEZONE=America/New_York

# --- Deployment (docker-compose.prod.yml only) -----------------------------
# Host port the site is served on, and the host directory holding the sqlite
# database. On TrueNAS point DATA_PATH at a dedicated dataset.
HOST_PORT=8080
DATA_PATH=./data
PUID=1000
PGID=1000
